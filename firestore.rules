rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.isVerified == false
        && request.resource.data.verificationStatus == 'none';

      // Note: `credits` is still a client-trusted field (no Cloud Functions
      // in this project yet) — see CreditService's class doc for the
      // production hardening this needs before real money is involved.
      //
      // The self-update branch compares against the CURRENT value with a
      // safe fallback (_currentBool/_currentStr below) instead of a raw
      // resource.data.isVerified == ... equality - a doc that ever ended
      // up with a missing/null isVerified (pre-redesign account,
      // interrupted write, etc.) would otherwise fail that check on EVERY
      // future write forever, permanently blocking onboarding for that
      // user. This still prevents a user from granting themselves verified
      // status or setting an admin-only status value, while letting a
      // verified user keep editing their profile (isVerified must stay
      // whatever it already was) and letting a broken doc recover.
      allow update: if request.auth != null && (
        request.auth.token.email == "rekhavijay9890@gmail.com" ||
        (request.auth.uid == userId &&
          request.resource.data.isVerified == _currentBool(resource.data, 'isVerified') &&
          (request.resource.data.verificationStatus == 'none' ||
           request.resource.data.verificationStatus == 'pending' ||
           request.resource.data.verificationStatus == _currentStr(resource.data, 'verificationStatus', 'none'))
        ) ||
        // Referral bonus: a NEW user's signup grants credits into the
        // REFERRER's doc, so this can't go through the auth.uid == userId
        // branch above. Narrowly scoped to touching only `credits`, and
        // only by exactly the admin-configured referral bonus (config/app,
        // falls back to 50) - not a general "anyone can edit anyone's
        // credits" hole.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits']) &&
          request.resource.data.credits == resource.data.credits + _referralBonusAmount())
      );

      // Delete Account: only the account owner may delete their own doc.
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /transactions/{txnId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || request.auth.token.email == "rekhavijay9890@gmail.com");
        allow create: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.token.email == "rekhavijay9890@gmail.com" ||
          (request.resource.data.type == 'referral' && request.resource.data.delta == _referralBonusAmount())
        );
        // Needed for ProfileService.deleteAllUserData - Firestore never
        // cascade-deletes subcollections when the parent users/{userId}
        // doc is deleted, so without this, every deleted account's
        // transaction ledger was silently orphaned forever instead of
        // actually being removed.
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // A user's own log of "friends I've invited by mobile number" - see
      // CreditService.logManualInvite / tryCompleteManualInvite.
      match /referralInvites/{inviteId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        // The REFERRED person (not the invite owner) flips it from
        // 'invited' to 'completed' once they've signed up with this
        // referrer's code - narrowly scoped to just that one transition,
        // nothing else about the invite may change.
        allow update: if request.auth != null &&
          resource.data.status == 'invited' &&
          request.resource.data.status == 'completed' &&
          request.resource.data.phone == resource.data.phone;
        // See the matching comment on transactions/{txnId} above.
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // In-app notifications (credit added, profile viewed, new message,
      // interest received/accepted). Only the owner may ever read, mark
      // read, or delete their own notifications - but the ACTOR who
      // triggers one (the message sender, the profile viewer, the person
      // whose interest just got accepted) is a different user than
      // `userId`, so create is intentionally open to any signed-in user,
      // same client-trust model as the rest of this app. Bounded to the
      // well-formed shape NotificationService always writes.
      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null &&
          request.resource.data.read == false &&
          request.resource.data.keys().hasAll(['type', 'title', 'body', 'createdAt']);
      }

      // A user's own saved Search filter combinations - fully private,
      // never written by anyone but the owner.
      match /savedSearches/{searchId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "rekhavijay9890@gmail.com";
    }

    match /interests/{interestId} {
      // `resource == null` (nonexistent doc) has to be allowed through here
      // too - InterestService.hasExistingInterest .get()s an interest that,
      // the FIRST time you ever like someone, doesn't exist yet. Without
      // this, that read throws permission-denied (not "not found"), which
      // aborted _sendInterest before it could actually write anything -
      // the heart flipped liked then immediately reverted on every tap.
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.fromUid != request.resource.data.toUid;

      // Only the receiver can accept/reject a pending interest (closes the
      // self-accept hole); the original sender may reset a rejected OR
      // withdrawn interest back to pending to try again later, or withdraw
      // (unlike) a still-pending one they sent.
      allow update: if request.auth != null &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.toUid == resource.data.toUid &&
        (
          (request.auth.uid == resource.data.toUid && resource.data.status == 'pending') ||
          (request.auth.uid == resource.data.fromUid &&
            (resource.data.status == 'rejected' || resource.data.status == 'withdrawn') &&
            request.resource.data.status == 'pending') ||
          (request.auth.uid == resource.data.fromUid && resource.data.status == 'pending' &&
            request.resource.data.status == 'withdrawn')
        );
    }

    match /matches/{matchId} {
      // `resource == null` covers the "does a match exist yet" read a chat
      // screen does before one has been created — without it, Firestore
      // rejects the read with permission-denied (not "not found") since
      // `resource.data` can't be evaluated on a null resource, which used
      // to make the chat icon silently fail for any two people who haven't
      // matched yet.
      allow read, update: if request.auth != null &&
        (resource == null || request.auth.uid in resource.data.participants);

      // A match may only be created once a mutual, accepted interest
      // exists between the same two participants — this is what actually
      // enforces "both sides consented" instead of trusting the client.
      // Requires interests to use a deterministic `{fromUid}_{toUid}` doc
      // id (see InterestService.sendInterest) so it can be looked up here.
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2 &&
        (
          _acceptedInterest(request.resource.data.participants[0], request.resource.data.participants[1]) ||
          _acceptedInterest(request.resource.data.participants[1], request.resource.data.participants[0])
        );

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.senderId &&
          request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
      }
    }

    match /reports/{reportId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reporterUid;
      allow read, update: if request.auth != null && request.auth.token.email == "rekhavijay9890@gmail.com";
    }

    // Astrologer consultation callback requests - a user submits their own,
    // only the admin can list/update them (mark contacted).
    match /astrologerRequests/{requestId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || request.auth.token.email == "rekhavijay9890@gmail.com");
      allow update: if request.auth != null && request.auth.token.email == "rekhavijay9890@gmail.com";
    }

    // Manual UPI top-up requests - see ManualTopupService's class doc. A
    // user submits a claim ("I paid ₹X, here's my UTR"); only the admin can
    // list/approve/reject them. Submitting a request never grants credits
    // by itself - approval does that separately via the users/{userId} and
    // transactions rules above, both of which already allow the admin
    // email unrestricted access.
    match /manualTopups/{requestId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || request.auth.token.email == "rekhavijay9890@gmail.com");
      allow update: if request.auth != null && request.auth.token.email == "rekhavijay9890@gmail.com";
    }

    function _acceptedInterest(fromUid, toUid) {
      return exists(/databases/$(database)/documents/interests/$(fromUid + '_' + toUid)) &&
        get(/databases/$(database)/documents/interests/$(fromUid + '_' + toUid)).data.status == 'accepted';
    }

    // Safe field readers used by the users/{userId} self-update rule so a
    // doc missing a field (rather than having it explicitly set) doesn't
    // permanently fail every future equality check against it.
    function _currentBool(data, key) {
      return (key in data) ? data[key] : false;
    }
    function _currentStr(data, key, fallback) {
      return (key in data) ? data[key] : fallback;
    }

    // Mirrors CreditService.getReferralBonusAmount() so the client and the
    // rule that validates a referral credit write always agree on today's
    // admin-configured amount.
    function _referralBonusAmount() {
      return exists(/databases/$(database)/documents/config/app) &&
        'referralBonus' in get(/databases/$(database)/documents/config/app).data
        ? get(/databases/$(database)/documents/config/app).data.referralBonus
        : 50;
    }
  }
}
