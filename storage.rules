rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos: any signed-in user may read (browsing matches), but
    // only the owner may write/delete their own folder - the folder name
    // IS the uid, so this can't be spoofed by another authenticated user.
    match /profile_photos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Chat images: readable/writable by any signed-in user, scoped per
    // match folder. Matches the existing client behavior in chat_page.dart
    // (no per-match membership check here yet - same trust model as the
    // rest of this client-driven app).
    match /chat_images/{matchId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
